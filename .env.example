# ── Variabel Database ────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=ganti_root_password_aman
MYSQL_DATABASE=uks_pmr
MYSQL_USER=uks_user
MYSQL_PASSWORD=ganti_password_aman

# ── Variabel Aplikasi ────────────────────────────────────────────────────────
# Port yang dibuka ke host (default: 8080)
APP_PORT=8080

# URL base API yang dipakai frontend saat build
# Karena Nginx mem-proxy /api/ ke backend secara internal, cukup pakai /api
VITE_API_BASE_URL=/api

# ── Lokasi Database ──────────────────────────────────────────────────────────
# AKTIF = jalankan container MySQL lokal (service "db" di docker-compose).
# Kosongkan/hapus baris ini jika memakai database di SERVER TERPISAH,
# lalu isi DATABASE_URL di bawah.
COMPOSE_PROFILES=local-db

# Jika memakai database server terpisah, hapus tanda # dan sesuaikan:
# DATABASE_URL=mariadb://uks_user:password_anda@192.168.1.50:3306/uks_pmr

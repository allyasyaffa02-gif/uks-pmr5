generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model MasterKategori {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  pasiens   Pasien[]

  @@map("master_kategori")
}

model Pasien {
  id          BigInt         @id @default(autoincrement())
  name        String         @db.VarChar(100)
  kelas       String         @db.VarChar(10)
  kategoriId  BigInt         @map("kategori_id")
  kategori    MasterKategori @relation(fields: [kategoriId], references: [id])
  date        DateTime       @db.Date
  time        String         @db.VarChar(10)
  keluhan     String         @db.Text
  penanganan  String         @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime?      @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")
  pasianObats Pasian_Obat[]

  @@map("pasien")
}

model Pasian_Obat {
  id        BigInt    @id @default(autoincrement())
  pasienId  BigInt    @map("pasien_id")
  pasien    Pasien    @relation(fields: [pasienId], references: [id])
  obatId    BigInt    @map("obat_id")
  obat      Obat      @relation(fields: [obatId], references: [id])
  jumlah    String    @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("pasian_obat")
}

model Obat {
  id                BigInt             @id @default(autoincrement())
  name              String             @db.VarChar(120)
  tanggalBeli       DateTime           @db.Date
  tanggalKadaluarsa DateTime           @db.Date
  stok              BigInt             @default(0)
  satuanId          BigInt             @map("satuan_id")
  satuan            Master_Satuan_Obat @relation(fields: [satuanId], references: [id])
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime?          @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")
  pasianObats       Pasian_Obat[]

  @@map("obat")
}

model Master_Satuan_Obat {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  obats     Obat[]

  @@map("master_satuan_obat")
}

model User {
  id        BigInt    @id @default(autoincrement())
  username  String    @unique @db.VarChar(50)
  password  String    @db.VarChar(255)
  isAdmin   Boolean   @default(false) @map("is_admin")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions  UserSession[]

  @@map("users")
}

/// Satu baris = satu sesi login (satu refresh token yang masih hidup).
/// `id` sengaja berupa string acak (bukan autoincrement) supaya id sesi sudah
/// bisa ditanam di dalam JWT sebelum barisnya dibuat - tidak perlu insert dulu
/// lalu update, dan id-nya tidak bisa ditebak.
/// Refresh token disimpan dalam bentuk hash SHA-256, bukan token aslinya,
/// sehingga bocornya isi tabel tidak langsung memberi akses ke akun.
/// `expires_at` digeser maju setiap kali token di-rotate (sliding 3 hari).
model UserSession {
  id               String    @id @db.VarChar(32)
  userId           BigInt    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

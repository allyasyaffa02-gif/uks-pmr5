# ─── DATABASE_URL ────────────────────────────────────────────────────────────
# Satu variabel untuk Prisma CLI (migrate / db pull / studio) DAN runtime NestJS.
# Skema yang dikenali: mysql:// | mariadb:// | tidb://  (provider Prisma tetap "mysql")
# Format: "<scheme>://{user}:{password}@{host}:{port}/{nama_db}"
# Password dengan karakter khusus sebaiknya ditulis ter-encode (%40 untuk @, %3A untuk :)
# Penjelasan lengkap (TLS, sslaccept, pool_size): lihat prisma/db-url.ts
#
# 1) MySQL/MariaDB di mesin sendiri (contoh: service "db" pada docker-compose,
#    yang memetakan port 3307 ke host)
DATABASE_URL="mariadb://root:password@127.0.0.1:3307/uks_pmr"
#
# 2) MySQL/MariaDB di server terpisah
# DATABASE_URL="mariadb://uks_user:password@192.168.1.50:3306/uks_pmr"
#
# 3) TiDB Cloud (Serverless/Dedicated) - port 4000 dan WAJIB TLS (otomatis
#    dinyalakan untuk host yang mengandung "tidb"). Pakai endpoint
#    "gateway01.<region>...", JANGAN yang "-privatelink" (hanya reachable dari
#    dalam VPC AWS), dan daftarkan IP publik Anda di TiDB Cloud > Connect.
# DATABASE_URL="mysql://<key>.root:<password>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/db_uks"
#
#    Safari/VPN/mesin dengan sertifikat self-signed boleh memakai:
# DATABASE_URL="mysql://<key>.root:<password>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/db_uks?sslaccept=accept_invalid_certificates"
#
# ─── Opsional ────────────────────────────────────────────────────────────────
# Shadow database untuk `prisma migrate dev` (MySQL/TiDB butuh CREATE DATABASE):
# SHADOW_DATABASE_URL=""
# Tune connection pool runtime lewat query param:
# DATABASE_URL="mariadb://root:password@127.0.0.1:3307/uks_pmr?pool_size=20&connect_timeout=30000"

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# JWT_SECRET: WAJIB diisi di produksi. Buat nilai acak panjang, mis.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Bila kosong, backend memakai secret default yang TIDAK aman dan menulis
# peringatan di log (hanya untuk memudahkan development).
JWT_SECRET=""

# JWT_EXPIRES_IN: umur access token. Pendek, ditandatangani ulang lewat
# POST /api/auth/refresh (frontend melakukannya otomatis saat menerima 401).
JWT_EXPIRES_IN="1h"

# JWT_REFRESH_EXPIRES_IN: umur refresh token = sliding window sesi.
# Selama user masih aktif, masa berlaku sesi digeser maju setiap kali token
# dirotasi; 3 hari TANPA aktivitas membuat sesi berakhir (harus login lagi).
JWT_REFRESH_EXPIRES_IN="3d"

# JWT_ISSUER / JWT_AUDIENCE: klaim iss & aud yang ikut diverifikasi.
# JWT_ISSUER="uks-pmr-backend"
# JWT_AUDIENCE="uks-pmr-frontend"

# ─── Cookie & CORS ────────────────────────────────────────────────────────────
# Daftar origin frontend yang boleh memakai cookie (pisahkan dengan koma).
# Tidak boleh "*": browser menolak wildcard bila credentials aktif.
CORS_ORIGIN="http://localhost:5173"

# Refresh token disimpan di cookie httpOnly; atur kebijakannya di sini.
# SameSite: "Lax" atau "Strict" bila frontend & backend satu situs; pilih
# "None" (otomatis memaksa Secure) bila berbeda situs/domain.
COOKIE_SAME_SITE="Lax"
# Paksa cookie hanya lewat HTTPS. Otomatis aktif saat NODE_ENV=production.
# COOKIE_SECURE="true"
# Ubah bila prefix API bukan /api (cookie dibatasi ke /api/auth).
# AUTH_COOKIE_PATH="/api/auth"
